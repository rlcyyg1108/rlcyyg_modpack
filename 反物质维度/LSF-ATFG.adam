//50%+BH is required, you may need a TT/s Glyph
//You can use it if you can complete any EC 5 times in seconds
//ALL RUs & Perks
auto infinity 1e30 x highest
auto eternity off

//If you have 1e18 RM, POUR ALL OF YOUR RM to Teresa
//Switch to LSF-UFGV!
if rm<1e18{
  auto eternity 1e3 x highest
}
if rm>=1e18{
  auto eternity off
  notify "SWITCH TO LSF-UFGV!"
}

//Pre-181 RAM and ECs
studies purchase XFR
auto infinity off

wait total TT>=362
auto eternity off

if ec1 completions<5{
  eternity respec
  studies purchase 11-62,infinity,111,active,151-181|1!
  wait pending completions>=5
  eternity
  studies purchase XFR
}

if ec2 completions<5{
  studies purchase XFR
  start ec2
  wait pending completions>=5
  eternity
  studies purchase XFR
}

if ec3 completions<5{
  eternity respec
  studies purchase 11-62,antimatter,111,active,151-181|3!
  wait pending completions>=5
  eternity
  studies purchase XFR
}

auto eternity 1e10 x highest
wait total TT>=452
auto eternity off

if ec4 completions<5{
  eternity respec
  studies nowait purchase NORM
  start ec4
  studies nowait purchase NORM
  wait pending completions>=5
  eternity respec
  studies purchase XFR
}

if ec5 completions<5{
  eternity respec
  studies purchase 11-62,infinity,111,active,151-181|5!
  wait pending completions>=5
  eternity
  studies purchase XFR
}

if ec6 completions<5{
  eternity respec
  studies purchase 11-62,infinity,111,active,151-181|6!
  wait pending completions>=5
  eternity
  studies purchase XFR
}

if ec7 completions<5{
  eternity respec
  studies purchase 11-62,antimatter,111,active,151-181|7!
  wait pending completions>=5
  eternity
  studies purchase XFR
}

if ec8 completions<5{
  eternity respec
  studies nowait purchase NORM
  start ec8
  wait pending completions>=5
  eternity respec
  studies purchase XFR
}

auto eternity 1e30 x highest
wait total TT>=737
auto eternity off

if ec9 completions<5{
  studies purchase XFR
  start ec9
  studies purchase XFR
  wait pending completions>=5
  eternity
  studies purchase XFR
}

auto eternity on
wait total TT>=872
auto eternity off

if ec10 completions<5{
  eternity respec
  studies purchase 11-62,antimatter,111,active,151-181|10!
  wait pending completions>=5
  eternity
  studies purchase PREDIL
}

//Want 12865 TT 4 Dilation
auto eternity 1e50 x highest
studies purchase PREDIL
wait total TT>=12865
auto eternity off

//Dilation #1, get initial TP
unlock dilation
start dilation
studies nowait purchase FIN
pause 0.1s
eternity respec

//EC11-12
if ec12 completions<5{
  studies nowait purchase NORM
  start ec12
  wait pending completions>=5
  eternity
  studies purchase FIN
}
if ec11 completions<5{
  studies nowait purchase NORM
  start ec11
  wait pending completions>=5
  eternity
  studies purchase FIN
}

//Dilation #2, farm more TP
studies purchase FIN
start dilation
studies purchase FIN
pause 1s
eternity
studies purchase FIN

//Restart auto eternity, get more EP 4 Reality
if rm<=1e18{
  auto eternity 1e500 x highest
}
if rm>=1e18{
  auto eternity off
  notify "SWITCH TO LSF-UFGV!"
}

wait reality